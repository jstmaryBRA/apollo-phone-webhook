# Required
APOLLO_PHONE_WEBHOOK_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional — Railway sets RAILWAY_PUBLIC_DOMAIN automatically
# PUBLIC_BASE_URL=https://your-service.up.railway.app

# Optional explicit override (otherwise built from PUBLIC_BASE_URL + secret)
# APOLLO_PHONE_WEBHOOK_URL=https://your-service.up.railway.app/webhooks/apollo-phone/change-me

# Optional — custom storage path (use a Railway volume mount in production)
# WEBHOOK_DATA_DIR=/data/webhooks/apollo_phone
